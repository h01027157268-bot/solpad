# ---------------------------------------------------------------------------
# SolPad environment
# ---------------------------------------------------------------------------
# Empty = the app runs on its offline mirror engine (fully usable, no chain).
# Set it to a deployed program id to switch every screen to the chain.
NEXT_PUBLIC_PROGRAM_ID=

NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# The platform vault: the 1% slice of every trade lands here.
# This is the value the scripts initialise Config.treasury with.
NEXT_PUBLIC_TREASURY=EYB8XKsysDpSkK4PdBg4Rx3EMqY5NJ1LGfmvUdiKkqaQ

# Only used when the live feed cannot reach Binance/CoinGecko.
NEXT_PUBLIC_SOL_PRICE=180

# Outbound HTTP(S) for the server-side live feed (/api/live).
# Node's fetch does not use the Windows system proxy, so if your machine needs
# one, put it here and Node 22+ will honour it via NODE_USE_ENV_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
NODE_USE_ENV_PROXY=

